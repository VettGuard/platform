# VettGuard root .env.example — copy to .env.local for development.
# Real secrets MUST never be committed. Production secrets live in Sealed Secrets.

# ─── App URLs (dev) ─────────────────────────────────────────────────────────
APP_LANDING_URL=http://localhost:3000
APP_DASHBOARD_URL=http://localhost:3001
APP_ADMIN_URL=http://localhost:3002
APP_GATEWAY_URL=http://localhost:8080

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vettguard
POSTGRES_PASSWORD=vettguard_dev
POSTGRES_DB=vettguard

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── NATS ──────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ─── MinIO (S3-compatible) ─────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vettguard-dev

# ─── Stripe (test keys) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ─── OAuth ─────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ─── ELD ───────────────────────────────────────────────────────────────────
MOTIVE_CLIENT_ID=
MOTIVE_CLIENT_SECRET=
SAMSARA_CLIENT_ID=
SAMSARA_CLIENT_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
# In dev, Mailpit captures email at http://localhost:8025

# ─── Auth secrets ──────────────────────────────────────────────────────────
JWT_SIGNING_KEY=dev-only-key-do-not-use-in-prod-32bytes-min
ENCRYPTION_KEY=dev-only-key-do-not-use-in-prod-32bytes-min

# ─── OTel ──────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=vettguard
