{
  "manifest_version": 3,
  "name": "VettGuard",
  "version": "0.0.1",
  "description": "AI-native detention recovery and broker vetting — works inside DAT, Truckstop, 123Loadboard.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": ["storage", "identity", "alarms"],
  "host_permissions": [
    "https://*.dat.com/*",
    "https://*.truckstop.com/*",
    "https://*.123loadboard.com/*",
    "https://api.vettguard.com/*",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.dat.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.truckstop.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.123loadboard.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://*.dat.com/*",
        "https://*.truckstop.com/*",
        "https://*.123loadboard.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
