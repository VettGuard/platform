{
  "name": "@vettguard/proto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VettGuard protobuf/Connect-RPC contracts and generated TS stubs",
  "exports": {
    ".": "./gen/ts/index.ts",
    "./v1/*": "./gen/ts/v1/*.ts"
  },
  "scripts": {
    "generate": "buf generate",
