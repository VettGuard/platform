{
  "name": "@vettguard/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VettGuard shared UI library — theme tokens, components, utilities",
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.4",
    "tailwind-merge": "^2.5.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vettguard/config": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.0"
  }
}
